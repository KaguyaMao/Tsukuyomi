{
  "name": "tsukuyomi",
  "version": "0.6.2",
  "description": "Tsukuyomi (formerly KaguyaPi) — a Grok Build-style agent TUI with OpenCode-style workspace panels and multi-provider sign-in, powered by the Pi coding-agent kernel.",
  "type": "module",
  "bin": {
    "tsukuyomi": "bin/tsukuyomi.mjs",
    "kaguyapi": "bin/kaguyapi.mjs"
  },
  "files": [
    "app/",
    "bin/",
    "src/",
    "docs/",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./src/backend.ts"
    ]
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "package:npm": "npm pack --ignore-scripts",
    "package:all": "bash packaging/build-packages.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@oh-my-pi/pi-natives": "18.2.2",
    "@xterm/headless": "5.5.0",
    "node-pty": "1.1.0",
    "smol-toml": "^1.7.0",
    "typebox": "1.3.30"
  }
}
